# Environment Variables

# Frontend Configuration (Vite)
#
# Copy this file to .env in the project root if needed.
# Local development already uses these default URLs.
#
# Never put secret API keys in VITE_ variables.
# They are exposed to the browser.

VITE_BACKEND_URL=http://localhost:8000

# Optional overrides
# VITE_API_URL=http://localhost:8000/api
# VITE_WS_URL=ws://localhost:8000/ws

# Backend credentials are configured in backend/.env.
# Refer to backend/.env.example for setup instructions.
