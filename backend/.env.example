
# Bird Strike Detection System - Backend Configuration
#
# Copy this file to backend/.env and fill in the credentials.
# Never commit real API keys to GitHub.
#
# BirdNET species detection does not require these API keys.

# Google Gemini API
# Used for AI-generated bird call interpretations.
# Create API key: https://aistudio.google.com/apikey
# Setup guide: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API
# Used for real-time weather information.
# Create API key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Unsplash API (Optional)
# Used to retrieve bird images.
# Create application: https://unsplash.com/oauth/applications
UNSPLASH_API_KEY=your_unsplash_api_key_here

# Weather Location
# Default: Kuala Lumpur, Malaysia
# Change these coordinates for your testing location.
MALAYSIA_LAT=3.1390
MALAYSIA_LON=101.6869

# Weather Update Interval (Seconds)
WEATHER_UPDATE_INTERVAL=300

# Database (Optional)
# SQLite is used by default.
# DATABASE_URL=sqlite:///bird_strike_detection.db

# Hugging Face Deployment
# HF_TOKEN is configured in GitHub Actions Secrets,
# not in this .env file.
#
# GitHub Repository > Settings >
# Secrets and variables > Actions
